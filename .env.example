# IDRISK2 — Exemplo de configuração
# Copie este ficheiro para .env e preencha os valores

# --- Obrigatórias ---

# Chave HMAC para cadeia de logs de auditoria tamper-evident
# Gerar com: python3 -c "import secrets; print(secrets.token_hex(32))"
IDRISK2_AUDIT_KEY=

# Diretório base para índice Chroma, logs de auditoria e registos
IDRISK2_DATA_DIR=./data

# Diretório com documentos EFSA FoodEx2 (PDF/TXT/MD)
IDRISK2_DOCS_DIR=./docs/efsa

# --- OpenAI (necessária para VLM gpt4o e LLM gpt-4o) ---
OPENAI_API_KEY=

# --- Anthropic (necessária para VLM claude) ---
ANTHROPIC_API_KEY=

# --- Cache local (evita problemas de permissão) ---
LLAMA_INDEX_CACHE_DIR=./.cache/llama_index
TRANSFORMERS_CACHE=./.cache/transformers
HF_HOME=./.cache/huggingface

# --- Opcionais ---
IDRISK2_LOG_LEVEL=INFO
IDRISK2_MAX_RETRIES=2
